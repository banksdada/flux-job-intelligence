# Copy this file to .env and fill in any keys you have.
# Flux runs fine with none of these set — it just uses fewer live sources.

# Port the server listens on (Coolify will usually map this via its proxy)
PORT=8765

# Reed API — free, register at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Adzuna API — free, register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API — free, register at https://jooble.org/api/about
JOOBLE_API_KEY=

# Careerjet API — free affiliate ID, register at https://www.careerjet.com/partners/api
CAREERJET_AFFILIATE_ID=

# Where Flux itself is reachable — used only as the "results page" Careerjet's
# API asks for. Set this to your real deployed URL if it's not fluxjobs.baseuse.xyz.
FLUX_PUBLIC_URL=https://fluxjobs.baseuse.xyz

# Where job/CV/bookmark JSON files are persisted.
# In Docker/Coolify this should point at your mounted volume.
FLUX_DATA_DIR=./data
