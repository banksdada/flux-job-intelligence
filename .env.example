# Copy this file to .env and fill in any keys you have.
# Flux runs fine with none of these set — it just uses fewer live sources.

# Port the server listens on (Coolify will usually map this via its proxy)
PORT=8765

# Reed API — free, register at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Adzuna API — free, register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where job/CV/bookmark JSON files are persisted.
# In Docker/Coolify this should point at your mounted volume.
FLUX_DATA_DIR=./data
